---
import type {Project} from '../data/projects';
import Icon from './Icon.astro';
interface Props {project: Project;}
const {project:p}=Astro.props;
---
<article class:list={['project-card',p.color,p.slug]} data-reveal>
  <a class="project-art" href={`/work/${p.slug}/`} aria-label={`The story behind ${p.name}`}>
    <div class="project-art-top mono"><span>{p.category}</span><span>{p.number} / 06</span></div>
    {p.slug==='abraham'?<div class="abraham-gallery"><img class="artwork artwork-back" src="/images/abraham-ledger.webp" alt="Ledger, Not Dogma — a work from Abraham’s Covenant, a project by Gene Kogan" width="1400" height="781" loading="lazy"/><img class="artwork artwork-front" src="/images/abraham-three-proofs.webp" alt="Three Proofs of Holding Together — a work from Abraham’s Covenant, a project by Gene Kogan" width="1400" height="781" loading="lazy"/><span class="artwork-inscription">An artist.<br/>A practice.<br/><em>A becoming.</em></span></div>:p.slug==='common-arcade'?<div class="arcade-visual"><span class="arcade-title">COMMON<br/><span>ARCADE</span></span><img class="game-cover game-redline" src="/images/arcade-redline.webp" alt="Redline Run, a racing game on Common Arcade" width="800" height="450" loading="lazy"/><img class="game-cover game-duel" src="/images/arcade-duel.webp" alt="Live Duel, a game for humans and agents" width="800" height="450" loading="lazy"/><span class="arcade-seat mono"><i></i> PLAYER 01 / HUMAN <i></i> PLAYER 02 / AGENT</span></div>:p.slug==='arttribute'?<div class="ecosystem-visual"><svg viewBox="0 0 400 300" fill="none" aria-hidden="true"><path d="M200 145 65 70M200 145 330 70M200 145 90 245M200 145 320 245"/><circle cx="200" cy="145" r="82" stroke-dasharray="2 6"/></svg><span class="ecosystem-core">Arttribute<span>THE CONNECTING THREAD</span></span><span class="eco-node eco-agent">Agent<br/>Commons <i>↗</i></span><span class="eco-node eco-provenance">Pr<span>ProvenanceKit</span></span><span class="eco-node eco-lab">Common<br/><em>Lab</em></span><span class="eco-node eco-arcade">Common<br/>Arcade </span></div>:<div class="project-screen"><div class="screen-bar"><i></i><i></i><i></i><span>{p.domain}</span></div><img src={`/images/${p.image}`} alt={p.alt} width="1440" height="1040" loading="lazy" decoding="async"/></div>}
    <span class="art-caption">{p.slug==='abraham'?'A project by Gene Kogan':p.slug==='provenancekit'?'From research to working infrastructure':p.slug==='common-arcade'?'Humans + agents. Let’s play.':p.slug==='commonlab'?'Learn it. Build it. Make it your own.':p.slug==='arttribute'?'Tracing the people behind the work.':'Your agents. Your tools. Your choice.'}</span>
    <span class="project-art-arrow"><Icon name="external" size={23}/></span>
  </a>
  <div class="project-info"><div><span class="project-role">{p.role}</span><h3><a href={`/work/${p.slug}/`}>{p.name}</a></h3></div><a class="project-visit" href={p.url} target="_blank" rel="noopener noreferrer" aria-label={`Visit ${p.name} (opens in a new tab)`}><Icon name="external" size={22}/></a></div>
  <p class="project-summary">{p.summary}</p>
  <a class="text-link" href={`/work/${p.slug}/`}>The story behind it <Icon name="arrow" size={18}/></a>
</article>
