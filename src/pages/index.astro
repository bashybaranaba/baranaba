---
import Layout from '../layouts/Layout.astro';
import HeroArtwork from '../components/HeroArtwork.astro';
import OriginStory from '../components/OriginStory.astro';
import Icon from '../components/Icon.astro';
import ProjectCard from '../components/ProjectCard.astro';
import {projects,readings} from '../data/projects';
---
<Layout>
  <div class="hero-band"><section class="hero container" aria-labelledby="hero-heading">
    <div class="hero-copy"><p class="eyebrow hero-eyebrow"><span class="status-dot"></span> Software engineer · Researcher · Builder</p><h1 id="hero-heading">Curiosity,<br/>put to<br/><em>work.</em></h1><p class="hero-intro">Hi, I’m Baranaba. I build at the intersection of AI, creative work, and human agency. Ideas draw me in. Making them work keeps me there.</p><div class="hero-actions"><a class="button button-dark" href="#work">Explore my work <Icon name="down" size={18}/></a><a class="quiet-link" href="#about">A little about me <Icon name="arrow" size={17}/></a></div></div>
    <HeroArtwork/>
  </section></div>

  <OriginStory/>

  <section id="work" class="work-section container" aria-labelledby="work-heading"><div class="section-heading" data-reveal><div><h2 id="work-heading">Questions, made <em>tangible.</em></h2></div><p>A connected body of work.<br/>A few different ways into it.</p></div><div class="project-grid">{projects.map(project=><ProjectCard project={project}/>)}</div></section>

  <section id="research" class="research-section" aria-labelledby="research-heading"><div class="container research-inner"><div class="research-copy" data-reveal><h2 id="research-heading">Behind every output,<br/>there’s a <em>process.</em></h2><p class="research-lead">My research starts there.</p><p>My master’s thesis explored what we need to know about human–AI creation before we can meaningfully discuss credit, rights, and responsibility. I connected legal and governance questions to the design of a working provenance system.</p><p>That work became ProvenanceKit. The relationship runs both ways: research sharpens what I build, and building gives the research something concrete to answer to.</p><div class="research-actions"><a class="button button-dark" href="/documents/Baranaba-Mugabane-Masters-Thesis.pdf" target="_blank" rel="noopener noreferrer">Read the thesis <Icon name="external" size={17}/></a><a class="text-link" href="/work/provenancekit/">Explore the research <Icon name="arrow" size={17}/></a></div><p class="research-universities">AI for Sustainable Societies · 2026<br/>Tampere University · Tallinn University · Lusófona University</p></div><div class="research-art" data-reveal><div class="research-art-label mono"><span>A CHAIN OF CREATION</span><span>↘</span></div><div class="provenance-diagram" role="img" aria-label="An illustrative creation history: a human idea, an AI draft, a human edit, and a final work, connected by provenance records"><div class="diagram-node"><span class="node-icon">01</span><div><small>ENTITY / HUMAN</small><strong>A spark of an idea</strong></div><span class="node-dot"></span></div><div class="diagram-connector"><span></span><small>prompt · context · intention</small></div><div class="diagram-node node-ai"><span class="node-icon">02</span><div><small>ACTION / GENERATE</small><strong>Something to work with</strong></div><span class="node-dot"></span></div><div class="diagram-connector"><span></span><small>review · select · transform</small></div><div class="diagram-node"><span class="node-icon">03</span><div><small>ACTION / HUMAN EDIT</small><strong>A point of view</strong></div><span class="node-dot"></span></div><div class="diagram-connector"><span></span><small>contribution, carried forward</small></div><div class="diagram-result"><span class="result-symbol">Pr<span>↗</span></span><div><small>THE WORK, WITH ITS HISTORY</small><strong>A clearer story.</strong></div></div></div><p class="diagram-note mono">ILLUSTRATIVE WORKFLOW · INSPIRED BY THE EAA MODEL</p></div></div></section>

  <section id="teaching" class="teaching-section container" aria-labelledby="teaching-heading"><div class="section-heading" data-reveal><div><h2 id="teaching-heading">Good questions.<br/>Open laptops. <em>Real people.</em></h2></div><div class="teaching-intro"><p>I facilitate AI workshops and training for people with different backgrounds, from software teams to educators and everyday professionals.</p><p>The goal is practical understanding: try something, inspect the result, and develop the judgment to know where AI belongs in your work.</p></div></div><div class="workshop-gallery"><figure class="workshop-main" data-reveal><button class="gallery-open" data-image="/images/moringa-workshop.webp" data-caption="AI Skills for Everyday Work · Moringa School, Nairobi · With Jessica Francisca Colaço" aria-label="Enlarge the Moringa School workshop photograph"><img src="/images/moringa-workshop.webp" alt="Baranaba, Jessica Francisca Colaço, and participants after an AI workshop at Moringa School in Nairobi" width="1800" height="1350" loading="lazy"/><span class="image-expand"><Icon name="plus" size={20}/></span></button><figcaption><span>Moringa School, Nairobi</span><span class="mono">AI SKILLS FOR EVERYDAY WORK</span></figcaption></figure><figure class="workshop-secondary" data-reveal><button class="gallery-open" data-image="/images/workshop-show-tell.webp" data-caption="AI Quick Wins · Show & Tell · A CommonLab community session" aria-label="Enlarge the AI Quick Wins presentation photograph"><img src="/images/workshop-show-tell.webp" alt="Baranaba presenting an AI Quick Wins Show and Tell session, with CommonLab and Agent Commons on screen" width="1400" height="1050" loading="lazy"/><span class="image-expand"><Icon name="plus" size={20}/></span></button><figcaption><span>From the workshop floor</span><span class="mono">SHOW, TRY, DISCUSS</span></figcaption></figure></div><div class="teaching-bottom" data-reveal><p class="teaching-organizations">Workshops & learning with<br/><a href="https://moringaschool.com" target="_blank" rel="noopener noreferrer">Moringa School <Icon name="external" size={14}/></a><span class="org-separator">/</span><a href="https://www.tlu.ee/en" target="_blank" rel="noopener noreferrer">Tallinn University <Icon name="external" size={14}/></a></p><div class="teaching-links"><a class="text-link" href="mailto:bashybaranaba@gmail.com?subject=Let%E2%80%99s%20plan%20an%20AI%20workshop">Bring a workshop to your team <Icon name="arrow" size={18}/></a><a class="quiet-link" href="https://commonlab.agentcommons.io" target="_blank" rel="noopener noreferrer">Keep learning on CommonLab <Icon name="external" size={16}/></a></div></div></section>

  <section id="experience" class="about-section" aria-labelledby="experience-heading">
    <div class="container background-grid">
      <div class="about-copy" data-reveal>
        <h2 id="experience-heading">A practice shaped by<br/><em>different worlds.</em></h2>
        <p>My path has taken me from computer science at Strathmore University to educational technology in Tallinn, autonomous creative agents at Eden Labs, and a master’s in AI for Sustainable Societies across Estonia, Finland, and Portugal.</p>
        <p>Along the way, I’ve worked on health research and spent a lot of time thinking about how people meet technology. Moving between these settings gives me new ways to approach a problem, and real situations to test the ideas against.</p>
        <div class="about-skills"><span>Systems & software</span><span>Applied AI</span><span>Creative technology</span><span>Research</span><span>Teaching</span></div>
        <a class="text-link" href="/documents/Baranaba-Mugabane-CV.pdf" target="_blank" rel="noopener noreferrer">The fuller picture — my résumé <Icon name="external" size={18}/></a>
      </div>
      <div class="experience-list"><div><span class="experience-date">2025 — 2026</span><div><h3>Software Engineer <span>· Eden Labs</span></h3><p>Infrastructure for autonomous creative AI agents.</p></div></div><div><span class="experience-date">2024 — 2025</span><div><h3>Software Developer <span>· Tallinn University</span></h3><p>AI learning tools grounded in pedagogical research.</p></div></div><div><span class="experience-date">2023</span><div><h3>Engineering & Research <span>· Strathmore / @iLabAfrica</span></h3><p>Mobile health software and machine learning for local food research.</p></div></div><div><span class="experience-date">2020 — 2026</span><div><h3>Computer Science → AI for Sustainable Societies</h3><p>First-class honours at Strathmore. Joint master’s studies across three European universities.</p></div></div></div>
    </div>
  </section>

  <section class="notes-section container" aria-labelledby="notes-heading"><div class="section-heading" data-reveal><div><h2 id="notes-heading">Notes from <em>the journey.</em></h2></div><p>Ideas, conversations,<br/>and things I’m learning.</p></div><div class="reading-grid">{readings.map(r=><a class="reading-card" href={r.url} target="_blank" rel="noopener noreferrer" data-reveal><div class="reading-meta mono"><span>{r.type}</span><span>{r.date}</span></div><h3>{r.title}</h3><p>{r.description}</p><div class="reading-bottom"><span>{r.publisher}</span><Icon name="external" size={22}/></div></a>)}</div><div class="earlier-work"><span class="mono">ALSO IN THE NOTEBOOK</span><a href="https://github.com/bashybaranaba/Feedback-mobile-games" target="_blank" rel="noopener noreferrer">Feedback Games <small>Accessible play · Mozilla Open Leaders 2018</small><Icon name="external" size={17}/></a><a href="https://www.tlu.ee/en/dt/mediahub/blogs/award-winning-innovations-aiss-students-edtech-hackathon-2024" target="_blank" rel="noopener noreferrer">SkillCraft <small>AI roleplay · EdTech Hackathon 2024</small><Icon name="external" size={17}/></a></div></section>

  <dialog class="photo-dialog" aria-label="Workshop photograph"><button class="dialog-close" aria-label="Close photograph">Close <span aria-hidden="true">×</span></button><img src="" alt=""/><p></p></dialog>
  <script>
    const dialog=document.querySelector<HTMLDialogElement>('.photo-dialog');
    if(dialog){
      document.querySelectorAll<HTMLButtonElement>('.gallery-open').forEach(button=>button.addEventListener('click',()=>{
        const img=dialog.querySelector('img');const caption=dialog.querySelector('p');
        if(img){img.src=button.dataset.image||'';img.alt=button.querySelector('img')?.alt||'';}
        if(caption)caption.textContent=button.dataset.caption||'';
        dialog.showModal();document.body.classList.add('dialog-open');
      }));
      dialog.querySelector('.dialog-close')?.addEventListener('click',()=>dialog.close());
      dialog.addEventListener('close',()=>document.body.classList.remove('dialog-open'));
      dialog.addEventListener('click',event=>{if(event.target===dialog)dialog.close();});
    }
  </script>
</Layout>
