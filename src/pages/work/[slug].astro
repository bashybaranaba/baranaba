---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import {projects} from '../../data/projects';
export function getStaticPaths(){return projects.map((project,index)=>({params:{slug:project.slug},props:{project,next:projects[(index+1)%projects.length]}}));}
const {project:p,next}=Astro.props;
---
<Layout title={`${p.name} — A project story by Baranaba Mugabane`} description={p.summary}>
  <article class:list={['case-study',p.color]}>
    <header class="case-header container"><a class="back-link mono" href="/#work"><span aria-hidden="true">←</span> SELECTED WORK / {p.number}</a><div class="case-title-row"><div><p class="eyebrow">{p.category}</p><h1>{p.name}<span>.</span></h1></div><a class="button button-dark" href={p.url} target="_blank" rel="noopener noreferrer">Visit the project <Icon name="external" size={18}/></a></div><p class="case-question">{p.question}</p><div class="case-meta"><span>{p.role}</span><span>{p.domain} <Icon name="external" size={12}/></span></div></header>
    <div class="container"><figure class="case-cover"><div class="case-cover-top mono"><span>{p.slug==='abraham'?'ABRAHAM — A PROJECT BY GENE KOGAN':p.name.toUpperCase()}</span><span>A WINDOW INTO THE WORK ↗</span></div>{p.slug==='abraham'?<img src="/images/abraham-three-proofs.webp" alt="Three Proofs of Holding Together, from Abraham’s Covenant, a project by Gene Kogan" width="1400" height="781" fetchpriority="high"/>:<img src={`/images/${p.image}`} alt={p.alt} width="1440" height="1040" fetchpriority="high"/>}<figcaption><span>{p.slug==='abraham'?'Three Proofs of Holding Together · Abraham, by Gene Kogan. Featured with his permission.':'Project website · captured October 2026'}</span><a href={p.url} target="_blank" rel="noopener noreferrer">Explore the live project <Icon name="external" size={13}/></a></figcaption></figure></div>
    <div class="case-content container"><aside class="case-sidebar"><span class="section-index mono">THE SHAPE OF THE WORK</span><dl>{p.details.map(d=><div><dt>{d.label}</dt><dd>{d.value}</dd></div>)}</dl><a class="text-link" href={p.url} target="_blank" rel="noopener noreferrer">{p.domain} <Icon name="external" size={16}/></a>{p.slug==='abraham'&&<p class="collaboration-credit">Original project and artistic direction by <a href="https://genekogan.com" target="_blank" rel="noopener noreferrer">Gene Kogan</a>. My role was an engineering contribution as part of the Eden collaboration.</p>}</aside><div class="case-story"><p class="case-intro" data-reveal>{p.intro}</p>{p.sections.map((section,index)=><section class="story-section" data-reveal><span class="mono story-chapter">0{index+1} / THE STORY</span><h2>{section.title}</h2>{section.paragraphs.map(paragraph=><p>{paragraph}</p>)}</section>)}<div class="case-sources" data-reveal><span class="mono">EXPLORE THE WORK & ITS CONTEXT</span><p>Some doors into the project, its origins, and the people around it.</p>{p.sources.map(source=><a href={source.url} target="_blank" rel="noopener noreferrer"><div><strong>{source.title}</strong><span>{source.note}</span></div><Icon name="external" size={20}/></a>)}</div></div></div>
  </article>
  <section class="next-story container"><span class="mono">ANOTHER THREAD TO FOLLOW / {next.number}</span><a href={`/work/${next.slug}/`}><div><h2>{next.name}</h2><p>{next.question}</p></div><span class="next-arrow"><Icon name="external" size={40}/></span></a></section>
</Layout>
